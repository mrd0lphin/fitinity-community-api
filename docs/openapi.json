{
  "openapi": "3.0.3",
  "info": {
    "title": "Fitinity Community API",
    "version": "1.0.0",
    "description": "Backend acadêmico em Node.js, Express e PostgreSQL. Respostas de sucesso usam data; erros usam error. Imagens retornam caminhos relativos /uploads/arquivo.ext, acessíveis no mesmo host. Sem frontend próprio."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:3000",
      "description": "Desenvolvimento local"
    }
  ],
  "tags": [
    {
      "name": "Autenticação"
    },
    {
      "name": "Perfil"
    },
    {
      "name": "Publicações"
    },
    {
      "name": "Curtidas"
    },
    {
      "name": "Comentários"
    },
    {
      "name": "Sistema"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "Sistema"
        ],
        "operationId": "health",
        "summary": "Verificar disponibilidade",
        "security": [],
        "responses": {
          "200": {
            "description": "Servidor e banco disponíveis.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data"
                  ],
                  "properties": {
                    "data": {
                      "type": "object",
                      "required": [
                        "status",
                        "database"
                      ],
                      "properties": {
                        "status": {
                          "type": "string",
                          "enum": [
                            "ok"
                          ]
                        },
                        "database": {
                          "type": "string",
                          "enum": [
                            "connected"
                          ]
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "503": {
            "$ref": "#/components/responses/503"
          }
        }
      }
    },
    "/api/auth/register": {
      "post": {
        "tags": [
          "Autenticação"
        ],
        "operationId": "register",
        "summary": "Cadastrar usuário",
        "description": "Normaliza o e-mail para letras minúsculas. Não retorna senha, hash ou token.",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Usuário cadastrado.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data"
                  ],
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/User"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/400"
          },
          "409": {
            "$ref": "#/components/responses/409"
          }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "tags": [
          "Autenticação"
        ],
        "operationId": "login",
        "summary": "Autenticar e emitir token",
        "description": "JWT HS256 com issuer fitinity-api e audience fitinity-community. Expiração definida por JWT_EXPIRES_IN.",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login realizado.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data"
                  ],
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/LoginResult"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/400"
          },
          "401": {
            "$ref": "#/components/responses/401"
          }
        }
      }
    },
    "/api/users/me": {
      "get": {
        "tags": [
          "Perfil"
        ],
        "operationId": "getMe",
        "summary": "Consultar perfil autenticado",
        "responses": {
          "200": {
            "description": "Operação realizada.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data"
                  ],
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/User"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/401"
          }
        }
      },
      "patch": {
        "tags": [
          "Perfil"
        ],
        "operationId": "updateMe",
        "summary": "Atualizar nome ou e-mail do próprio perfil",
        "description": "Senha, id e autoria não são editáveis por esta rota.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProfileInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Operação realizada.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data"
                  ],
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/User"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/400"
          },
          "401": {
            "$ref": "#/components/responses/401"
          },
          "409": {
            "$ref": "#/components/responses/409"
          }
        }
      }
    },
    "/api/users/me/avatar": {
      "post": {
        "tags": [
          "Perfil"
        ],
        "operationId": "uploadAvatar",
        "summary": "Enviar ou substituir avatar",
        "description": "JPEG (.jpg/.jpeg), PNG (.png) ou WebP (.webp), até 5.242.880 bytes. Extensão, MIME e conteúdo devem corresponder. O arquivo deve ser uma imagem decodificável. Máximo de 16 milhões de pixels, sem animação.",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": [
                  "avatar"
                ],
                "properties": {
                  "avatar": {
                    "type": "string",
                    "format": "binary",
                    "description": "JPEG (.jpg/.jpeg), PNG (.png) ou WebP (.webp), até 5.242.880 bytes. Extensão, MIME e conteúdo devem corresponder. O arquivo deve ser uma imagem decodificável. Máximo de 16 milhões de pixels, sem animação."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Operação realizada.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data"
                  ],
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/User"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/400"
          },
          "401": {
            "$ref": "#/components/responses/401"
          },
          "413": {
            "$ref": "#/components/responses/413"
          },
          "415": {
            "$ref": "#/components/responses/415"
          }
        }
      },
      "delete": {
        "tags": [
          "Perfil"
        ],
        "operationId": "deleteAvatar",
        "summary": "Excluir avatar e arquivo associado",
        "responses": {
          "204": {
            "description": "Avatar removido; resposta sem corpo."
          },
          "401": {
            "$ref": "#/components/responses/401"
          }
        }
      }
    },
    "/api/posts": {
      "post": {
        "tags": [
          "Publicações"
        ],
        "operationId": "createPost",
        "summary": "Criar publicação com imagem opcional",
        "description": "A autoria vem do JWT. Com imagem utilize multipart/form-data com content e image. Imagens: até 5 MB, até 16 milhões de pixels, sem animação.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PostInput"
              }
            },
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "content"
                ],
                "properties": {
                  "content": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 5000
                  },
                  "image": {
                    "type": "string",
                    "format": "binary",
                    "description": "JPEG (.jpg/.jpeg), PNG (.png) ou WebP (.webp), até 5.242.880 bytes. Extensão, MIME e conteúdo devem corresponder. O arquivo deve ser uma imagem decodificável. Máximo de 16 milhões de pixels, sem animação."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Publicação criada.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data"
                  ],
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Post"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/400"
          },
          "401": {
            "$ref": "#/components/responses/401"
          },
          "413": {
            "$ref": "#/components/responses/413"
          },
          "415": {
            "$ref": "#/components/responses/415"
          }
        }
      },
      "get": {
        "tags": [
          "Publicações"
        ],
        "operationId": "listPosts",
        "summary": "Listar publicações",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1,
              "maximum": 1000000
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Página de resultados.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data",
                    "pagination"
                  ],
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Post"
                      }
                    },
                    "pagination": {
                      "$ref": "#/components/schemas/Pagination"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/400"
          },
          "401": {
            "$ref": "#/components/responses/401"
          }
        },
        "description": "Ordenação da publicação mais recente para a mais antiga, com desempate pelo id."
      }
    },
    "/api/posts/{id}": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "description": "Identificador inteiro positivo de 32 bits.",
          "schema": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          }
        }
      ],
      "get": {
        "tags": [
          "Publicações"
        ],
        "operationId": "getPost",
        "summary": "Consultar publicação",
        "responses": {
          "200": {
            "description": "Operação realizada.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data"
                  ],
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Post"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/400"
          },
          "401": {
            "$ref": "#/components/responses/401"
          },
          "404": {
            "$ref": "#/components/responses/404"
          }
        }
      },
      "patch": {
        "tags": [
          "Publicações"
        ],
        "operationId": "updatePost",
        "summary": "Editar publicação própria",
        "description": "Permite substituir image ou remover a imagem com remove_image=true. image e remove_image=true juntos são inválidos. A autorização ocorre antes do processamento do upload. Imagens: até 5 MB, até 16 milhões de pixels, sem animação.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PostUpdate"
              }
            },
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "content": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 5000
                  },
                  "image": {
                    "type": "string",
                    "format": "binary",
                    "description": "JPEG (.jpg/.jpeg), PNG (.png) ou WebP (.webp), até 5.242.880 bytes. Extensão, MIME e conteúdo devem corresponder. O arquivo deve ser uma imagem decodificável. Máximo de 16 milhões de pixels, sem animação."
                  },
                  "remove_image": {
                    "type": "boolean",
                    "description": "Em multipart envie true/false em texto. Não combinar true e image."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Operação realizada.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data"
                  ],
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Post"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/400"
          },
          "401": {
            "$ref": "#/components/responses/401"
          },
          "403": {
            "$ref": "#/components/responses/403"
          },
          "404": {
            "$ref": "#/components/responses/404"
          },
          "413": {
            "$ref": "#/components/responses/413"
          },
          "415": {
            "$ref": "#/components/responses/415"
          }
        }
      },
      "delete": {
        "tags": [
          "Publicações"
        ],
        "operationId": "deletePost",
        "summary": "Excluir publicação própria",
        "description": "Exclui curtidas e comentários por cascata e remove a imagem associada.",
        "responses": {
          "204": {
            "description": "Publicação excluída; resposta sem corpo."
          },
          "400": {
            "$ref": "#/components/responses/400"
          },
          "401": {
            "$ref": "#/components/responses/401"
          },
          "403": {
            "$ref": "#/components/responses/403"
          },
          "404": {
            "$ref": "#/components/responses/404"
          }
        }
      }
    },
    "/api/posts/{id}/likes": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "description": "Identificador inteiro positivo de 32 bits.",
          "schema": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          }
        }
      ],
      "post": {
        "tags": [
          "Curtidas"
        ],
        "operationId": "likePost",
        "summary": "Curtir publicação",
        "description": "Operação idempotente: repetir não cria outra curtida para o mesmo usuário.",
        "responses": {
          "200": {
            "description": "Curtida já existente.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data"
                  ],
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Like"
                    }
                  }
                }
              }
            }
          },
          "201": {
            "description": "Curtida criada.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data"
                  ],
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Like"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/400"
          },
          "401": {
            "$ref": "#/components/responses/401"
          },
          "404": {
            "$ref": "#/components/responses/404"
          }
        }
      },
      "delete": {
        "tags": [
          "Curtidas"
        ],
        "operationId": "unlikePost",
        "summary": "Remover própria curtida",
        "description": "Se a publicação existe, repetir a remoção também retorna 204.",
        "responses": {
          "204": {
            "description": "Curtida removida; resposta sem corpo."
          },
          "400": {
            "$ref": "#/components/responses/400"
          },
          "401": {
            "$ref": "#/components/responses/401"
          },
          "404": {
            "$ref": "#/components/responses/404"
          }
        }
      }
    },
    "/api/posts/{id}/comments": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "description": "Identificador inteiro positivo de 32 bits.",
          "schema": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          }
        }
      ],
      "post": {
        "tags": [
          "Comentários"
        ],
        "operationId": "createComment",
        "summary": "Comentar publicação",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CommentInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Comentário criado.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data"
                  ],
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Comment"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/400"
          },
          "401": {
            "$ref": "#/components/responses/401"
          },
          "404": {
            "$ref": "#/components/responses/404"
          }
        }
      },
      "get": {
        "tags": [
          "Comentários"
        ],
        "operationId": "listComments",
        "summary": "Listar comentários de uma publicação",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1,
              "maximum": 1000000
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Página de resultados.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data",
                    "pagination"
                  ],
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Comment"
                      }
                    },
                    "pagination": {
                      "$ref": "#/components/schemas/Pagination"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/400"
          },
          "401": {
            "$ref": "#/components/responses/401"
          },
          "404": {
            "$ref": "#/components/responses/404"
          }
        },
        "description": "Ordenação do comentário mais antigo para o mais recente, com desempate pelo id."
      }
    },
    "/api/comments/{id}": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "description": "Identificador inteiro positivo de 32 bits.",
          "schema": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          }
        }
      ],
      "patch": {
        "tags": [
          "Comentários"
        ],
        "operationId": "updateComment",
        "summary": "Editar comentário próprio",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CommentInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Operação realizada.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "data"
                  ],
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Comment"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/400"
          },
          "401": {
            "$ref": "#/components/responses/401"
          },
          "403": {
            "$ref": "#/components/responses/403"
          },
          "404": {
            "$ref": "#/components/responses/404"
          }
        }
      },
      "delete": {
        "tags": [
          "Comentários"
        ],
        "operationId": "deleteComment",
        "summary": "Excluir comentário próprio",
        "responses": {
          "204": {
            "description": "Comentário excluído; resposta sem corpo."
          },
          "400": {
            "$ref": "#/components/responses/400"
          },
          "401": {
            "$ref": "#/components/responses/401"
          },
          "403": {
            "$ref": "#/components/responses/403"
          },
          "404": {
            "$ref": "#/components/responses/404"
