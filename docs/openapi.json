  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "User": {
        "type": "object",
        "required": [
          "id",
          "name",
          "email",
          "avatar_url",
          "created_at",
          "updated_at"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1,
            "example": 1
          },
          "name": {
            "type": "string",
            "example": "Ana Silva"
          },
          "email": {
            "type": "string",
            "format": "email",
            "example": "ana@example.com"
          },
          "avatar_url": {
            "type": "string",
            "nullable": true,
            "example": null
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Post": {
        "type": "object",
        "required": [
          "id",
          "user_id",
          "content",
          "image_url",
          "created_at",
          "updated_at",
          "author",
          "likes_count",
          "comments_count",
          "liked_by_me"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1,
            "example": 1
          },
          "user_id": {
            "type": "integer",
            "minimum": 1,
            "example": 1
          },
          "content": {
            "type": "string",
            "example": "Treino de hoje concluído!"
          },
          "image_url": {
            "type": "string",
            "nullable": true,
            "example": null
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "author": {
            "$ref": "#/components/schemas/Author"
          },
          "likes_count": {
            "type": "integer",
            "minimum": 0,
            "example": 2
          },
          "comments_count": {
            "type": "integer",
            "minimum": 0,
            "example": 3
          },
          "liked_by_me": {
            "type": "boolean",
            "example": false
          }
        }
      },
      "Comment": {
        "type": "object",
        "required": [
          "id",
          "user_id",
          "post_id",
          "content",
          "created_at",
          "updated_at",
          "author"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1,
            "example": 1
          },
          "user_id": {
            "type": "integer",
            "minimum": 1,
            "example": 2
          },
          "post_id": {
            "type": "integer",
            "minimum": 1,
            "example": 1
          },
          "content": {
            "type": "string",
            "example": "Bom treino!"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "author": {
            "$ref": "#/components/schemas/Author"
          }
        }
      },
      "Like": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1
          },
          "user_id": {
            "type": "integer",
            "minimum": 1
          },
          "post_id": {
            "type": "integer",
            "minimum": 1
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "user_id",
          "post_id",
          "created_at"
        ]
      },
      "Pagination": {
        "type": "object",
        "required": [
          "page",
          "limit",
          "total",
          "totalPages"
        ],
        "properties": {
          "page": {
            "type": "integer",
            "example": 1
          },
          "limit": {
            "type": "integer",
            "example": 20
          },
          "total": {
            "type": "integer",
            "example": 1
          },
          "totalPages": {
            "type": "integer",
            "example": 1
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string",
                "example": "VALIDATION_ERROR",
                "enum": [
                  "VALIDATION_ERROR",
                  "UNAUTHORIZED",
                  "FORBIDDEN",
                  "NOT_FOUND",
                  "CONFLICT",
                  "FILE_TOO_LARGE",
                  "INVALID_FILE_TYPE",
                  "SERVICE_UNAVAILABLE",
                  "INTERNAL_ERROR",
                  "PAYLOAD_TOO_LARGE"
                ]
              },
              "message": {
                "type": "string",
                "example": "Verifique os dados enviados."
              },
              "details": {
                "description": "Detalhes opcionais de validação.",
                "nullable": true
              }
            }
          }
        }
      },
      "RegisterInput": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "email",
          "password"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 100,
            "example": "Ana Silva"
          },
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 254,
            "example": "ana@example.com"
          },
          "password": {
            "type": "string",
            "format": "password",
            "minLength": 8,
            "description": "Mínimo de 8 caracteres e máximo de 72 bytes UTF-8 (limite do bcrypt).",
            "example": "SenhaDidatica123!"
          }
        }
      },
      "LoginInput": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "email",
          "password"
        ],
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "example": "ana@example.com"
          },
          "password": {
            "type": "string",
            "format": "password",
            "example": "SenhaDidatica123!"
          }
        }
      },
      "ProfileInput": {
        "type": "object",
        "additionalProperties": false,
        "minProperties": 1,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 100
          },
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 254
          }
        }
      },
      "PostInput": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "content"
        ],
        "properties": {
          "content": {
            "type": "string",
            "minLength": 1,
            "maxLength": 5000,
            "example": "Treino de hoje concluído!"
          }
        }
      },
      "PostUpdate": {
        "type": "object",
        "additionalProperties": false,
        "minProperties": 1,
        "properties": {
          "content": {
            "type": "string",
            "minLength": 1,
            "maxLength": 5000
          },
          "remove_image": {
            "type": "boolean",
            "description": "true remove a imagem atual. Não combine com envio de image."
          }
        }
      },
      "CommentInput": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "content"
        ],
        "properties": {
          "content": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000,
            "example": "Bom treino!"
          }
        }
      },
      "LoginResult": {
        "type": "object",
        "required": [
          "token",
          "user",
          "expiresIn"
        ],
        "properties": {
          "token": {
            "type": "string",
            "description": "JWT Bearer. Use Authorize no Swagger."
          },
          "user": {
            "$ref": "#/components/schemas/User"
          },
          "expiresIn": {
            "type": "string",
            "example": "1h"
          }
        }
      },
      "Author": {
        "type": "object",
        "required": [
          "id",
          "name",
          "avatar_url"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1,
            "example": 1
          },
          "name": {
            "type": "string",
            "example": "Ana Silva"
          },
          "avatar_url": {
            "type": "string",
            "nullable": true,
            "example": null
          }
        }
      }
    },
    "responses": {
      "400": {
        "description": "Dados, identificadores ou parâmetros inválidos.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "401": {
        "description": "Autenticação ausente, inválida ou expirada.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "403": {
        "description": "O recurso pertence a outro usuário.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "404": {
        "description": "Recurso não encontrado.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "409": {
        "description": "E-mail já utilizado ou conflito de integridade.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "413": {
        "description": "Corpo ou arquivo acima do limite permitido.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "415": {
        "description": "Tipo de arquivo não aceito ou incompatível com seu conteúdo.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "503": {
        "description": "Banco de dados indisponível.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    }
  }
}
