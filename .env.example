# Copie para .env. Os valores abaixo são exemplos apenas para desenvolvimento.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
DATABASE_URL=postgresql://fitinity:fitinity_local_only@127.0.0.1:54329/fitinity
# Gere um segredo: node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=SUBSTITUA_POR_UM_SEGREDO_ALEATORIO_DE_32_CARACTERES_OU_MAIS
JWT_EXPIRES_IN=1h
BCRYPT_ROUNDS=10
UPLOAD_DIR=uploads
MAX_UPLOAD_BYTES=5242880
# Opcional: npm test inicia um PostgreSQL isolado se esta variável estiver vazia.
# Um banco externo deve ser dedicado a testes e ter nome terminado em "_test".
TEST_DATABASE_URL=
